
import json
import numpy as np
import pandas as pd

from m3_rental_demand.config import (
    MODULE_DIR,
    DATE_COLUMN,
    TARGET_COLUMN,
    REPORTS_DIR,
)

# --------------------------------------------------
# 1. Paths
# -------------------------------------------------

DATASET_PATH = (
    MODULE_DIR.parent
    / "data"
    / "ML"
    / "_M3_Rental_Demand_New_dataset1.csv"
)

PROCESSED_DIR = MODULE_DIR / "processed"
PROCESSED_DIR.mkdir(parents=True, exist_ok=True)
REPORTS_DIR.mkdir(parents=True, exist_ok=True)

OUTPUT_PATH = PROCESSED_DIR / "training_data.csv"
OBSERVED_PATH = PROCESSED_DIR / "training_data_observed_targets.csv"
ESTIMATED_PATH = PROCESSED_DIR / "training_data_estimated_targets.csv"
REPORT_PATH = REPORTS_DIR / "feature_engineering_report.json"


# --------------------------------------------------
# 2. The 13 input features used by the backend
# --------------------------------------------------

MODEL_FEATURES = [
    "city",
    "area_locality",
    "month",
    "property_count",
    "application_count",
    "agreement_start_count",
    "average_monthly_rent",
    "demand_lag_1_month",
    "demand_lag_2_month",
    "demand_growth_1_month",
    "occupancy_rate",
    "vacancy_rate",
    "available_unit_count",
]

# Required columns for training.
# year_month is converted to datetime.
# month is derived from year_month.
# next_month_demand is the target.

REQUIRED_COLUMNS = [
    "city",
    "area_locality",
    DATE_COLUMN,
    "property_count",
    "application_count",
    "agreement_start_count",
    "average_monthly_rent",
    "demand_lag_1_month",
    "demand_lag_2_month",
    "demand_growth_1_month",
    "occupancy_rate",
    "vacancy_rate",
    "available_unit_count",
    TARGET_COLUMN,
]

STATUS_COLUMNS = [
    "application_count_status",
    "next_month_demand_status",
]


def main():

    # --------------------------------------------------
    # 3. Load the CSV
    # --------------------------------------------------

    if not DATASET_PATH.exists():
        raise FileNotFoundError(
            f"Dataset not found: {DATASET_PATH}\n"
            "Check that the new CSV is inside the data/ML folder."
        )

    df = pd.read_csv(DATASET_PATH)
    source_rows = len(df)

    print(f"Dataset loaded: {DATASET_PATH}")
    print(f"Source rows: {source_rows}")

    if df.empty:
        raise ValueError("The input CSV contains no rows.")

    missing = [
        column
        for column in REQUIRED_COLUMNS
        if column not in df.columns
    ]

    if missing:
        raise ValueError(
            f"Missing required columns in CSV: {missing}"
        )

    available_status_columns = [
        column
        for column in STATUS_COLUMNS
        if column in df.columns
    ]

    keep_columns = list(dict.fromkeys(
        REQUIRED_COLUMNS + available_status_columns
    ))

    df = df[keep_columns].copy()

    # --------------------------------------------------
    # 4. Convert date and derive month
    # --------------------------------------------------

    df[DATE_COLUMN] = pd.to_datetime(
        df[DATE_COLUMN],
        errors="coerce",
    )

    invalid_dates = int(df[DATE_COLUMN].isna().sum())

    if invalid_dates:
        print(f"Rows with invalid dates: {invalid_dates}")

    df["month"] = df[DATE_COLUMN].dt.month

    # --------------------------------------------------
    # 5. Validate numeric values
    # --------------------------------------------------

    numeric_columns = [
        "property_count",
        "application_count",
        "agreement_start_count",
        "average_monthly_rent",
        "demand_lag_1_month",
        "demand_lag_2_month",
        "demand_growth_1_month",
        "occupancy_rate",
        "vacancy_rate",
        "available_unit_count",
        TARGET_COLUMN,
    ]

    for column in numeric_columns:
        df[column] = pd.to_numeric(
            df[column],
            errors="coerce",
        )

    df[numeric_columns] = df[numeric_columns].replace(
        [np.inf, -np.inf],
        np.nan,
    )

    # Remove rows with invalid dates or missing numeric values.
    valid_rows = (
        df[DATE_COLUMN].notna()
        & df[numeric_columns].notna().all(axis=1)
        & df["city"].notna()
        & df["area_locality"].notna()
    )

    removed_rows = int((~valid_rows).sum())
    df = df.loc[valid_rows].copy()

    print(
        "Rows removed due to invalid or missing values: "
        f"{removed_rows}"
    )
    print(f"Rows remaining: {len(df)}")

    if df.empty:
        raise ValueError(
            "No valid rows remain after data validation."
        )

    # Validate count-like columns.
    count_columns = [
        "property_count",
        "application_count",
        "agreement_start_count",
        "demand_lag_1_month",
        "demand_lag_2_month",
        "available_unit_count",
        TARGET_COLUMN,
    ]

    for column in count_columns:
        if (df[column] < 0).any():
            raise ValueError(
                f"{column} cannot contain negative values."
            )

        if not np.allclose(
            df[column],
            np.round(df[column]),
        ):
            raise ValueError(
                f"{column} must contain whole-number counts."
            )

        df[column] = df[column].round().astype(int)

    # Validate percentage features.
    for column in ["occupancy_rate", "vacancy_rate"]:
        if not df[column].between(0, 100).all():
            raise ValueError(
                f"{column} must be between 0 and 100."
            )

    if (df["average_monthly_rent"] < 0).any():
        raise ValueError(
            "average_monthly_rent cannot be negative."
        )

    # This dataset is intended to contain Hyderabad only.
    cities = (
        df["city"]
        .astype("string")
        .str.strip()
        .str.casefold()
        .unique()
    )

    if len(cities) != 1 or cities[0] != "hyderabad":
        raise ValueError(
            "Expected a Hyderabad-only dataset, but found "
            f"these city values: {list(cities)}"
        )

    # --------------------------------------------------
    # 6. Sort and check duplicate monthly records
    # --------------------------------------------------

    df["city"] = df["city"].astype("string").str.strip()
    df["area_locality"] = (
        df["area_locality"].astype("string").str.strip()
    )

    df = df.sort_values(
        ["city", "area_locality", DATE_COLUMN]
    ).reset_index(drop=True)

    duplicates = df.duplicated(
        subset=["city", "area_locality", DATE_COLUMN],
        keep=False,
    )

    if duplicates.any():
        duplicate_count = int(duplicates.sum())
        raise ValueError(
            f"Found {duplicate_count} rows belonging to duplicate "
            "city/locality/month records. Resolve duplicates first."
        )

    # --------------------------------------------------
    # 7. Preserve target provenance
    # --------------------------------------------------

    if "next_month_demand_status" in df.columns:
        status = (
            df["next_month_demand_status"]
            .astype("string")
            .str.strip()
            .str.upper()
        )

        df["target_provenance"] = status.where(
            status.isin(["OBSERVED", "ESTIMATED"]),
            "UNKNOWN",
        ).fillna("UNKNOWN")

    elif (
        DATASET_PATH.name
        == "Hyderabad_M3_Rental_Demand_New_Synthetic.csv"
    ):
        # These target values were simulated.
        # They are not verified real-world observations.
        df["target_provenance"] = "ESTIMATED"

    else:
        df["target_provenance"] = "UNKNOWN"

    # --------------------------------------------------
    # 8. Prepare and save training datasets
    # --------------------------------------------------

    output_columns = list(dict.fromkeys(
        MODEL_FEATURES
        + [DATE_COLUMN, TARGET_COLUMN, "target_provenance"]
        + available_status_columns
    ))

    prepared = df[output_columns].copy()

    prepared.to_csv(
        OUTPUT_PATH,
        index=False,
    )

    observed = prepared[
        prepared["target_provenance"] == "OBSERVED"
    ].copy()

    estimated = prepared[
        prepared["target_provenance"] == "ESTIMATED"
    ].copy()

    observed.to_csv(
        OBSERVED_PATH,
        index=False,
    )

    estimated.to_csv(
        ESTIMATED_PATH,
        index=False,
    )

    # --------------------------------------------------
    # 9. Save the feature engineering report
    # --------------------------------------------------

    provenance_counts = (
        prepared["target_provenance"]
        .value_counts()
        .to_dict()
    )

    report = {
        "source_dataset": str(DATASET_PATH),
        "source_rows": int(source_rows),
        "prepared_rows": int(len(prepared)),
        "removed_rows": int(removed_rows),
        "model_feature_count": len(MODEL_FEATURES),
        "model_features": MODEL_FEATURES,
        "date_column": DATE_COLUMN,
        "derived_month_feature": "month",
        "target_column": TARGET_COLUMN,
        "target_provenance_counts": {
            key: int(value)
            for key, value in provenance_counts.items()
        },
        "dataset_type": (
            "synthetic"
            if DATASET_PATH.name
            == "Hyderabad_M3_Rental_Demand_New_Synthetic.csv"
            else "source_dataset"
        ),
        "original_dataset_modified": False,
        "note": (
            "The new Hyderabad dataset contains simulated feature "
            "and target values. Metrics using these labels are "
            "experimental and do not establish real-world accuracy."
        ),
    }

    REPORT_PATH.write_text(
        json.dumps(report, indent=4),
        encoding="utf-8",
    )

    # --------------------------------------------------
    # 10. Print summary
    # --------------------------------------------------

    print("\nFeature engineering completed successfully.")
    print(f"Source rows: {source_rows}")
    print(f"Prepared rows: {len(prepared)}")
    print(f"Removed rows: {removed_rows}")
    print(f"Input features: {len(MODEL_FEATURES)}")
    print(f"Target column: {TARGET_COLUMN}")

    print("\nTarget provenance:")
    print(prepared["target_provenance"].value_counts())

    print("\nTarget distribution:")
    print(
        prepared[TARGET_COLUMN]
        .value_counts()
        .sort_index()
    )

    print(f"\nPrepared dataset: {OUTPUT_PATH}")
    print(f"Observed-target dataset: {OBSERVED_PATH}")
    print(f"Estimated-target dataset: {ESTIMATED_PATH}")
    print(f"Report: {REPORT_PATH}")


if __name__ == "__main__":
    main()
